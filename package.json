{
  "name": "coruja-procurement",
  "version": "1.0.0",
  "description": "Backend CAP para requisições e aprovações de compras",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "3.1.0",
    "@sap/cds": "10.1.0",
    "@sap/xsenv": "6.2.2",
    "@sap/xssec": "^4",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "1.0.2",
    "@cap-js/cds-types": "^0.20.0",
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/sqlite": "3.1.0",
    "@sap/cds-dk": "^10.0.6",
    "@types/node": "^24.0.0",
    "cds-plugin-ui5": "^0.13.0",
    "jest": "30.5.1",
    "supertest": "^7.2.2",
    "tsx": "^4",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch:hybrid": "cds watch --profile hybrid",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "npm run build && cf deploy mta_archives/archive.mtar",
    "ui:dev": "npm run dev --workspace procurement",
    "ui:build": "npm run build --workspace procurement"
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "requester": {
              "password": "requester-pass"
            },
            "manager.ops": {
              "password": "manager-pass",
              "roles": [
                "ProcurementApprover",
                "CostCenterManager"
              ]
            },
            "finance": {
              "password": "finance-pass",
              "roles": [
                "ProcurementApprover",
                "FinanceApprover"
              ]
            },
            "director": {
              "password": "director-pass",
              "roles": [
                "ProcurementApprover",
                "ProcurementDirector"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "OP_API_COSTCENTER_SRV_0001": {
        "kind": "odata-v2",
        "model": "srv/external/OP_API_COSTCENTER_SRV_0001",
        "credentials": {
          "destination": "S4HANA_ONPREM",
          "path": "/sap/opu/odata/sap/API_COSTCENTER_SRV"
        }
      },
      "OP_API_BUSINESS_PARTNER_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/OP_API_BUSINESS_PARTNER_SRV",
        "credentials": {
          "destination": "S4HANA_ONPREM",
          "path": "/sap/opu/odata/sap/API_BUSINESS_PARTNER"
        }
      },
      "OP_API_PRODUCT_SRV_0001": {
        "kind": "odata-v2",
        "model": "srv/external/OP_API_PRODUCT_SRV_0001",
        "credentials": {
          "destination": "S4HANA_ONPREM",
          "path": "/sap/opu/odata/sap/API_PRODUCT_SRV"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}