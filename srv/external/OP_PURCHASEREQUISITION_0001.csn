  "OP_PURCHASEREQUISITION_0001.PurchaseReqn": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "PurchaseRequisition": {
     "key": true,
     "type": "cds.String",
     "length": 10,
     "notNull": true,
     "@Core.Immutable": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Purchase Requisition",
     "@Common.Heading": "Purch.Reqn",
     "@Common.QuickInfo": "Purchase Requisition Number"
    },
    "PurchaseRequisitionType": {
     "type": "cds.String",
     "length": 4,
     "notNull": true,
     "@Common.SAPObjectNodeTypeReference": "PurchaseRequisitionType",
     "@Common.IsUpperCase": true,
     "@Common.Label": "Document Type",
     "@Common.QuickInfo": "Purchase Requisition Document Type"
    },
    "PurReqnDescription": {
     "type": "cds.String",
     "length": 40,
     "notNull": true,
     "@Common.Label": "PurReqn Description",
     "@Common.Heading": "Purchase Requisition Description",
     "@Common.QuickInfo": "Purchase Requisition Description"
    },
    "PurReqnHeaderNote": {
     "type": "cds.String",
     "notNull": true,
     "@Common.Label": "Long Text"
    },
    "SourceDetermination": {
     "type": "cds.Boolean",
     "notNull": true,
     "@Common.Label": "Checkbox"
    },
    "PurReqnDoOnlyValidation": {
     "type": "cds.Boolean",
     "notNull": true,
     "@Common.Label": "Boolean Variable (X = True, - = False, Space = Unknown)"
    },
    "SAP__Messages": {
     "items": {
      "type": "OP_PURCHASEREQUISITION_0001.SAP__Message",
      "notNull": true
     }
    },
    "_PurchaseRequisitionItem": {
     "type": "cds.Composition",
     "target": "OP_PURCHASEREQUISITION_0001.PurchaseReqnItem",
     "cardinality": {
      "max": "*"
     },
     "on": [
      {
       "ref": [
        "_PurchaseRequisitionItem",
        "_PurReqn"
       ]
      },
      "=",
      {
       "ref": [
        "$self"
       ]
      }
     ],
     "@Common.Composition": true
    }
   },
   "actions": {
    "Validate": {
     "kind": "action",
     "params": {}
    },
    "EnablePurReqForPurchasing": {
     "kind": "action",
     "params": {}
    },
    "DiscardPurReqFromPurchasing": {
     "kind": "action",
     "params": {}
    }
   },
   "@Common.Label": "Purchase Requisition",
   "@Common.SemanticKey": [
    "PurchaseRequisition"
   ],
   "@Common.Messages": {
    "=": "SAP__Messages"
   },
   "@Capabilities.NavigationRestrictions.RestrictedProperties": [
    {
     "NavigationProperty": {
      "=": "_PurchaseRequisitionItem"
     },
     "InsertRestrictions": {
      "Insertable": true
     }
    }
   ],
   "@Capabilities.SearchRestrictions.Searchable": false,
   "@Capabilities.FilterRestrictions.Filterable": true,
   "@Capabilities.FilterRestrictions.FilterExpressionRestrictions": [
    {
     "Property": {
      "=": "PurReqnHeaderNote"
     },
     "AllowedExpressions": "SearchExpression"
    }
   ],
   "@Capabilities.FilterRestrictions.NonFilterableProperties": [
    "PurReqnHeaderNote"
   ],
   "@Capabilities.SortRestrictions.NonSortableProperties": [
    "PurReqnHeaderNote"
   ],
   "@Capabilities.DeleteRestrictions.Deletable": false,
   "@Capabilities.UpdateRestrictions.QueryOptions.SelectSupported": true
  },
